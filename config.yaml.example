app:
  dry_run: false
  device_name: "YOUR_DEVICE_NAME"
  service_name: "Photo_Uploader"
  google_accounts:
    - "your_email_1@gmail.com"
    - "your_email_2@gmail.com"

database:
  nhost_enabled: true
  nhost_url: "postgres://user:password@host:port/dbname"
  neon_enabled: true
  neon_url: "postgresql://user:password@host/dbname?sslmode=require"

logging:
  loki_url: "https://logs-prod-xxx.grafana.net"
  loki_user_id: "YOUR_LOKI_USER_ID"
  loki_api_token: "YOUR_LOKI_API_TOKEN"

smtp:
  enabled: true
  server: "smtp.gmail.com"
  port: 587
  user: "your_email@gmail.com"
  password: "your_app_password"
  recipient: "recipient_email@gmail.com"

telegram:
  enabled: false
  token: "YOUR_BOT_TOKEN"
  chat_ids: 
    - "YOUR_CHAT_ID"
